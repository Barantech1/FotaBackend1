{
  "name": "fota-backend",
  "version": "0.1.0",
  "private": true,
  "description": "FOTA MVP local backend: firmware upload, per-user assignment, authenticated update check/download. See FOTA_MVP_Implementation_Plan_v0.2.md.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/multipart": "^8.3.0",
    "fastify": "^4.28.1"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  }
}
